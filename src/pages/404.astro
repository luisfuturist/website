---
import Navbar from '@/components/site/layout/Navbar.astro'
import Footer from '@/components/site/layout/Footer.astro'
import ErrorSection from '@/components/site/layout/ErrorSection'
import '../styles/global.css'
import 'augmented-ui/augmented-ui.css'
import MainLayout from '@/layouts/main.astro'
import { m } from '@/paraglide/messages.js'
---

<MainLayout title={m.meta_404_title()} description={m.meta_404_description()}>
  <div class="w-full lg:max-w-[1920px] lg:mx-auto px-4 lg:px-12 pb-4">
    <Navbar />

    <ErrorSection
      code="404"
      heading={m.notfound_heading()}
      lines={[m.notfound_text_a(), m.notfound_text_b()]}
      returnLabel={m.notfound_return()}
    />

    <Footer />
  </div>
</MainLayout>
