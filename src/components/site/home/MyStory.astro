---
import { linkify } from '@/lib/i18n'
import { m } from '@/paraglide/messages.js'

const bioLinks = [
  { href: 'https://neuralmind.ai', text: 'NeuralMind' },
  { href: 'https://9aia.com', text: 'Gaia' },
  { href: 'https://github.com/handl-lang', text: 'Handl' },
  { href: 'https://fiap.com.br', text: 'FIAP' },
  { href: 'https://github.com/m7tlab', text: 'm7tlab' },
]

const bioText = m.readme_bio({
  neuralmind: 'NeuralMind',
  gaia: 'Gaia',
  handl: 'Handl',
  fiap: 'FIAP',
  m7tlab: 'm7tlab',
})
const bioParts = linkify(bioText, bioLinks)
---

<section id="readme" class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start mb-48">
  <!-- Left side - Section Title -->
  <div class="space-y-8">
    <h2 class="text-foreground text-2xl font-mono tracking-wider uppercase">{m.nav_readme()}</h2>
  </div>

  <!-- Right side - Main Content -->
  <div class="space-y-4">
    <!-- Lyrical vision statement -->
    <p class="text-foreground text-4xl font-sans">
      {m.readme_vision()}
    </p>

    <!-- Bio -->
    <p class="text-foreground text-xs leading-relaxed font-sans max-w-md">
      {
        bioParts.map((part) =>
          typeof part === 'string' ? (
            part
          ) : (
            <a href={part.href} class="link">
              {part.text}
            </a>
          ),
        )
      }
    </p>

    <!-- Call to action link -->
    <div class="pt-2">
      <a
        href="https://linkedin.com/in/luisfuturist"
        target="_blank"
        class="flex w-fit text-sm font-normal text-foreground no-underline transition-opacity duration-300 hover:text-link-primary-hover uppercase"
      >
        <span aria-hidden="true" class="font-mono">
          {'['}
        </span>
        {m.readme_view_more()}
        <span aria-hidden="true" class="font-mono">
          {']'}
        </span>
      </a>
    </div>
  </div>
</section>
