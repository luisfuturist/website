---
import { m } from '@/paraglide/messages.js'
---

<section class="relative pt-12 mb-48">
  <!-- Top text sections -->
  <div class="grid grid-cols-2 gap-4">
    <!-- Left text -->
    <div class="max-w-md">
      <p class="text-foreground text-sm font-light leading-relaxed">
        {m.hero_today()}
      </p>
    </div>

    <!-- Right text -->
    <div class="max-w-md">
      <p class="text-foreground text-sm font-light leading-relaxed">
        {m.hero_tomorrow()}
      </p>
    </div>
  </div>

  <!-- Main headline -->
  <div class="text-center z-10 mt-12 lg:mt-0">
    <svg class="w-fitbbox font-flex" data-fitbbox-adjustment="0" aria-label={m.hero_aria()}>
      <text transform="translate(-0,0)">{m.hero_headline()}</text>
    </svg>
  </div>
</section>
