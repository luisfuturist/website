---
import { m } from '@/paraglide/messages.js'

// Projects component data
const services = [
  {
    title: 'Luis Emidio',
    subtitle: () => m.project_luis_subtitle(),
    link: 'https://github.com/luisfuturist',
    cta: () => m.project_cta_github(),
  },
  {
    title: 'Gaia',
    subtitle: () => m.project_gaia_subtitle(),
    link: 'https://9aia.com',
    cta: () => m.project_cta_website(),
  },
  {
    title: 'neuralmind.ai',
    subtitle: () => m.project_neuralmind_subtitle(),
    link: 'https://neuralmind.ai',
    cta: () => m.project_cta_website(),
  },
  {
    title: 'Handl',
    subtitle: () => m.project_handl_subtitle(),
    link: 'https://github.com/handl-lang',
    cta: () => m.project_cta_github(),
  },
  {
    title: 'm7tlab',
    subtitle: () => m.project_m7tlab_subtitle(),
    link: 'https://github.com/m7tlab',
    cta: () => m.project_cta_github(),
  },
]
---

<section id="projects" class="min-h-screen font-display grid grid-cols-1 lg:grid-cols-4 mb-48">
  <!-- Header -->
  <div class="mb-24 col-span-1">
    <h2 class="text-xl font-normal tracking-[0.2em] leading-relaxed uppercase">
      <span class="block">{m.projects_heading_a()}</span>
      <span class="block">{m.projects_heading_b()}</span>
    </h2>
  </div>

  <!-- Services List -->
  <div class="border-t border-foreground pt-8 col-span-3">
    {
      services.map((service, index) => (
        <a
          href={service.link}
          target="_blank"
          class="group flex flex-col w-full mb-16 pl-12 border-b border-foreground pb-12"
        >
          <div class="text-xl text-foreground font-mono group-hover:text-link-primary-hover">0{index + 1}</div>

          <div class="pl-5 flex justify-between items-end w-full">
            <div class="text-5xl sm:text-7xl md:text-7xl lg:text-8xl xl:text-9xl 2xl:text-10xl font-light leading-[0.9] text-foreground uppercase tracking-[-0.02em]">
              <div class="block font-display group-hover:text-link-primary-hover break-words break-all">
                {service.title}
              </div>
            </div>
          </div>

          <div class="w-full flex justify-end mt-12">
            <div class="flex text-sm font-normal text-foreground no-underline transition-opacity duration-300 group-hover:text-link-primary-hover uppercase">
              <span aria-hidden="true" class="font-mono">
                {'['}
              </span>
              {service.cta()}
              <span aria-hidden="true" class="font-mono">
                {']'}
              </span>
            </div>
          </div>
        </a>
      ))
    }
  </div>
</section>
