{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "typecheck": "astro check && eslint",
    "build": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && astro check && astro build",
    "preview": "astro build && wrangler pages dev ./dist",
    "deploy": "astro build && wrangler pages deploy ./dist",
    "astro": "astro",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "check:i18n": "inlang check --project ./project.inlang"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.3.5",
    "@astrojs/react": "^4.3.1",
    "@inlang/paraglide-js": "2.29.1",
    "@luisfuturist/ui": "github:luisfuturist/ui",
    "@tailwindcss/vite": "^4.1.13",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "astro": "^5.13.8",
    "augmented-ui": "^2.0.0",
    "canvas-confetti": "^1.9.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@astrojs/cloudflare": "^12.6.8",
    "@eslint-react/eslint-plugin": "^1.53.1",
    "@iconify/json": "^2.2.386",
    "@inlang/cli": "^3.4.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^9.36.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier-plugin-astro": "^0.14.1",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.7.2",
    "unplugin-icons": "^22.3.0",
    "vite-plugin-svgr": "^4.5.0",
    "wrangler": "^4.38.0"
  }
}
